# Server settings
# Host-side port. Container always listens on 8000 internally.
PORT=8005

# Frontend dev server host-side port
FRONTEND_PORT=5173

# LLM provider API keys (set only the ones you use)
ANTHROPIC_API_KEY=

# Max output tokens for the LLM (default 8192; raise for very long documents)
# ANTHROPIC_MAX_TOKENS=8192
# MAX_PDF_PAGES=10